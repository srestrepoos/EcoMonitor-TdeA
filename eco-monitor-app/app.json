{
  "expo": {
    "name": "EcoMonitor TdeA",
    "slug": "eco-monitor-tdea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ecomonitor",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0f1a"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0f1a"
      },
      "package": "co.tdea.ecomonitor",
      "newArchEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "17c1073e-0a64-4466-ae3c-c39b67ad2d3e"
      }
    },
    "owner": "srestrepo"
  }
}
